# Copia este archivo a .env.local y pon tu key real.
MASSIVE_API_KEY=tu_api_key_de_massive
MASSIVE_MAX_PAGES=40

# Auth de MarketSnack (para el sub-agente Time & Sales). Ver docs/marketsnack-token.md.
# Opción recomendada: token de servidor de larga vida (no caduca). Se usa como Bearer.
MARKETSNACK_TOKEN=
# Alternativa temporal: cookie de sesión del navegador (CADUCA en días).
# DevTools → Network → request a /api/flow_feed → copia el header "Cookie" completo.
MARKETSNACK_COOKIE=
